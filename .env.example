# =========================================================================== #
# Document RAG -- configuration
#
# Copy to `.env` and fill in. Every value the system reads is listed here;
# there are no hard-coded values in the source (ADR-012).
#
# Settings are validated at start-up. An invalid combination fails fast rather
# than surfacing as a wrong answer on your first question.
#
# Run `python -m rag --list-settings` to see this list from the code itself.
# =========================================================================== #

# --------------------------------------------------------------------------- #
# Application
# --------------------------------------------------------------------------- #
APP_ENV=local                     # local | development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                # console (human-readable) | json (production)

# --------------------------------------------------------------------------- #
# Credentials -- never commit real values
# --------------------------------------------------------------------------- #
# Answer generation needs exactly one of these, matching LLM_PROVIDER below.
OPENROUTER_API_KEY=               # openrouter.ai/keys  (the default provider)
GOOGLE_API_KEY=                   # aistudio.google.com/apikey  (LLM_PROVIDER=gemini)
OPENAI_API_KEY=                   # only for EMBEDDING_PROVIDER=openai
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------- #
# LLM (ADR-009)
#
# OpenRouter is the default: one key fronts every model it offers, so changing
# the answer model is a change to LLM_MODEL and nothing else. It speaks the
# OpenAI chat-completions protocol, which is what the adapter is built on.
#
#   qwen/qwen3-8b                    cheap, fast, good enough for cited answers
#   google/gemini-2.0-flash          the previous default, via OpenRouter
#   anthropic/claude-sonnet-4.5      best quality, highest cost
#
# The full catalogue is at openrouter.ai/models. Gemini remains selectable as a
# direct provider (LLM_PROVIDER=gemini + GOOGLE_API_KEY), in which case
# LLM_MODEL takes Google's own form, e.g. gemini-2.0-flash.
# --------------------------------------------------------------------------- #
LLM_PROVIDER=openrouter           # openrouter | gemini | openai | anthropic | local
LLM_MODEL=qwen/qwen3-8b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TEMPERATURE=0.0
MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_S=60.0

# Optional function-calling mode. OpenRouter only; deterministic RAG remains the default.
ENABLE_TOOL_CALLING=false
MAX_TOOL_ROUNDS=3
MAX_TOOL_CALLS_PER_ROUND=2
MAX_TOTAL_TOOL_CALLS=5
SEARCH_TOOL_MAX_TOP_K=20
TOOL_TIMEOUT_SECONDS=15
MAX_TOOL_RESULT_TOKENS=4000

# --------------------------------------------------------------------------- #
# Embeddings -- changing the model invalidates the index and forces a re-ingest
#
# The default runs on your machine: no API key, nothing charged per call, and no
# document text sent anywhere. The model (~130 MB) downloads once on first use.
#
#   local / BAAI/bge-small-en-v1.5        384 dims, ~130 MB   (default)
#   local / BAAI/bge-base-en-v1.5         768 dims, ~440 MB   (better quality)
#   openai / text-embedding-3-small      1536 dims            (needs OPENAI_API_KEY)
#
# EMBEDDING_DIMENSION must match the model. Start-up refuses to run if the
# existing Qdrant collection was built with a different model or width, because
# mismatched vectors return confidently wrong answers rather than failing.
# --------------------------------------------------------------------------- #
EMBEDDING_PROVIDER=local          # local | huggingface | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --------------------------------------------------------------------------- #
# Chunking (ADR-021: recursive is the default; semantic costs an embedding pass)
# --------------------------------------------------------------------------- #
CHUNKING_STRATEGY=recursive       # recursive | semantic | sentence
CHUNK_SIZE=800
CHUNK_OVERLAP=100                 # must be smaller than CHUNK_SIZE
MAX_CHUNK_TOKENS=1024
SEMANTIC_BREAKPOINT_PERCENTILE=95

# --------------------------------------------------------------------------- #
# Qdrant
# --------------------------------------------------------------------------- #
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=document_chunks
DISTANCE_METRIC=cosine            # cosine | dot | euclidean

# --------------------------------------------------------------------------- #
# Retrieval (ADR-006 hybrid, ADR-007 reciprocal rank fusion)
# --------------------------------------------------------------------------- #
TOP_K=20                          # candidates retrieved before reranking
RERANK_TOP_K=5                    # chunks passed to the LLM; must be <= TOP_K
ENABLE_HYBRID=true                # dense + BM25 sparse, fused by RRF
RRF_K=60
SPARSE_WEIGHT=0.5

# --------------------------------------------------------------------------- #
# Reranker (ADR-008)
# --------------------------------------------------------------------------- #
# Measured on CPU with 20 candidates:
#   BAAI/bge-reranker-v2-m3   ~2100 ms/query, 2.2 GB download   (best quality)
#   BAAI/bge-reranker-base     ~400 ms/query, 1.1 GB            (good balance)
#   cross-encoder/ms-marco-MiniLM-L-6-v2  ~60 ms/query, 90 MB   (fastest)
# The model loads once at start-up, not on the first question. On a GPU the
# largest model is comfortably fast; on CPU it dominates query latency.
ENABLE_RERANK=true
RERANKER_PROVIDER=bge             # bge | noop
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=16

# --------------------------------------------------------------------------- #
# Conversation memory (ADR-018: feeds the prompt, never retrieval)
# --------------------------------------------------------------------------- #
MEMORY_WINDOW_TURNS=6

# --------------------------------------------------------------------------- #
# Prompt / context construction
# --------------------------------------------------------------------------- #
MAX_PROMPT_TOKENS=8192
CONTEXT_TOKEN_BUDGET=4096         # must be smaller than MAX_PROMPT_TOKENS
PROMPT_VERSION=v1

# --------------------------------------------------------------------------- #
# Ingestion
# --------------------------------------------------------------------------- #
MAX_UPLOAD_BYTES=52428800         # 50 MiB
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown
UPLOAD_DIR=./uploads              # originals are kept so re-chunking stays possible
